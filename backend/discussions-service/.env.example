# Discussions Service Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# Mock Mode (for development/testing without CosmosDB)
# =============================================================================
USE_MOCK_DB=true

# =============================================================================
# Azure CosmosDB Configuration
# =============================================================================
# For local development with CosmosDB Emulator:
# COSMOS_ENDPOINT=https://localhost:8081
# COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# For Azure CosmosDB:
# COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/
# COSMOS_KEY=your-primary-key-here

COSMOS_ENDPOINT=
COSMOS_KEY=

# Database and container names
COSMOS_DATABASE_NAME=discussionsdb
COSMOS_ROOMS_CONTAINER=rooms
COSMOS_MESSAGES_CONTAINER=messages
COSMOS_INVITATIONS_CONTAINER=invitations
COSMOS_ATTACHMENTS_CONTAINER=attachments

# =============================================================================
# Application Configuration
# =============================================================================
DEBUG=false
LOCAL_DEV=false

# For CosmosDB Emulator, you may need to disable SSL verification
# COSMOS_EMULATOR_DISABLE_SSL_VERIFY=true
